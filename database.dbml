Project ogen {
  database_type: 'PostgreSQL'
  Note: 'Subscription & expense tracking MVP. Timestamps are timestamptz (server runs UTC); money is numeric(12,2) paired with an ISO-4217 currency.'
}

Enum vendor_category {
  COMMUNICATION
  INSURANCE
  STREAMING
  UTILITIES
  FITNESS
  SOFTWARE
  GROCERIES
  DINING
  TRANSPORTATION
  OTHER
}

Enum service_type {
  VIDEO_STREAMING
  MUSIC_STREAMING
  GAMING_SUBSCRIPTION
  GYM_MEMBERSHIP
  FITNESS_APP
  CLOUD_STORAGE
  PASSWORD_MANAGER
  VPN
  PRODUCTIVITY_SUITE
  AI_ASSISTANT
  DESIGN_TOOL
  NONE
}

Enum billing_cycle {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

Enum subscription_status {
  ACTIVE
  CANCELLATION_REQUESTED
  CANCELLED
}

Enum insight_type {
  OVERPAYING
  DUPLICATE
  HIGH_SPENDING
}

Enum insight_status {
  UNREAD
  READ
  ACTION_TAKEN
}

Enum import_source {
  CSV
  BANK_API
  MANUAL
  XLSX
}

Enum import_status {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  email varchar(255) [not null, note: 'Unique among non-deleted users only']
  password_hash varchar(255) [not null]
  full_name varchar(255) [not null]
  total_xp integer [not null, default: 0, note: 'Cached sum of xp_events.xp_awarded for this user']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz [null, note: 'Soft delete']

  indexes {
    email [unique, name: 'idx_users_email', note: 'Partial: WHERE deleted_at IS NULL, so a deleted account frees its email']
    deleted_at [name: 'idx_users_deleted_at']
  }
}

Table vendors {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(255) [not null, unique, note: 'Vendor name (e.g., Netflix, HOT)']
  cancellation_email varchar(255) [null, note: 'Official email for cancellation requests']
  average_market_price decimal(12,2) [null, note: 'Market benchmark price']
  currency char(3) [not null, default: 'ILS', note: 'ISO 4217 currency of average_market_price']
  category vendor_category [null]
  service_type service_type [null, note: 'Interchangeable service this vendor sells; two vendors sharing it are redundant. NONE when several such vendors are legitimate']
  is_likely_subscription boolean [null, note: 'AI classifier guess from the first charge; a subscription is only created once a second real charge confirms it']
  billing_cycle billing_cycle [null, note: 'AI classifier guess at cadence, used only once is_likely_subscription is confirmed by a second charge']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    service_type [name: 'idx_vendors_service_type']
  }
}

Table vendor_aliases {
  id uuid [pk, default: `gen_random_uuid()`]
  vendor_id uuid [not null, ref: > vendors.id]
  pattern varchar(255) [not null, unique, note: 'Normalized transaction description that resolves to this vendor']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    vendor_id [name: 'idx_vendor_aliases_vendor']
  }
}

Table statement_imports {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  source import_source [not null, default: 'CSV']
  status import_status [not null, default: 'PENDING']
  filename varchar(255) [null, note: 'Original upload name; null for API-sourced imports']
  transaction_count integer [not null, default: 0, note: 'Rows successfully ingested']
  error_message text [null, note: 'Populated when status is FAILED']
  completed_at timestamptz [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, created_at) [name: 'idx_statement_imports_user_created']
  }

  Note: 'One row per upload or sync. Undo is a soft delete of every transaction carrying this import_id.'
}

Table subscriptions {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  vendor_id uuid [null, ref: > vendors.id, note: 'Null until the vendor is resolved']
  amount decimal(12,2) [not null, note: 'Recurring charge amount']
  currency char(3) [not null, default: 'ILS']
  billing_cycle billing_cycle [not null, default: 'MONTHLY']
  status subscription_status [not null, default: 'ACTIVE']
  next_charge_date date [null]
  cancellation_requested_at timestamptz [null, note: 'Set when the cancellation email is sent']
  cancelled_at timestamptz [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz [null]

  indexes {
    (user_id, status) [name: 'idx_subscriptions_user_status']
    vendor_id [name: 'idx_subscriptions_vendor']
  }

  Note: 'Deliberately no unique (user_id, vendor_id): two ACTIVE subscriptions to one vendor is exactly what a DUPLICATE insight reports.'
}

Table transactions {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  vendor_id uuid [null, ref: > vendors.id, note: 'Null for unrecognized vendors']
  subscription_id uuid [null, ref: > subscriptions.id, note: 'Set once the charge is attributed to a recurring subscription']
  import_id uuid [null, ref: > statement_imports.id, note: 'Provenance; null for manually added transactions']
  external_id varchar(255) [null, note: 'Bank/CSV supplied identifier, unique per user when present']
  original_description varchar(512) [not null, note: 'Raw description from CSV/Bank']
  amount decimal(12,2) [not null]
  currency char(3) [not null, default: 'ILS']
  transaction_date date [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz [null]

  indexes {
    (user_id, external_id) [unique, name: 'idx_transactions_external_id', note: 'Partial: WHERE external_id IS NOT NULL']
    (user_id, transaction_date) [name: 'idx_transactions_user_date']
    (user_id, subscription_id) [name: 'idx_transactions_user_subscription']
    (user_id, transaction_date, amount) [name: 'idx_transactions_dedupe_lookup', note: 'Supports import-time duplicate detection when external_id is absent']
    import_id [name: 'idx_transactions_import', note: 'Supports undoing a whole import']
  }
}

Table insights {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  subscription_id uuid [null, ref: > subscriptions.id]
  transaction_id uuid [null, ref: > transactions.id, note: 'Linked to a specific transaction if relevant']
  type insight_type [not null]
  body text [not null]
  status insight_status [not null, default: 'UNREAD']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, status) [name: 'idx_insights_user_status']
    (user_id, subscription_id, type) [unique, name: 'idx_insights_unread_dedupe', note: 'Partial: WHERE status is UNREAD, so re-running detection cannot stack duplicate unread insights']
  }
}

Table levels {
  id uuid [pk, default: `gen_random_uuid()`]
  level_number integer [not null, unique, note: 'Natural key; users.current_level references this column']
  xp_required integer [not null, note: 'Cumulative total_xp needed to reach this level']
  title varchar(255) [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    level_number [unique, name: 'idx_levels_level_number']
    xp_required [name: 'idx_levels_xp_required']
  }

  Note: 'Fully configurable level ladder; editable with no deploy.'
}

Table xp_actions {
  id uuid [pk, default: `gen_random_uuid()`]
  key varchar(255) [not null, unique, note: 'Free-form action code, not a Postgres enum, so new actions need no migration']
  xp_value integer [not null]
  description text [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    key [unique, name: 'idx_xp_actions_key']
  }

  Note: 'DB-driven catalog of XP-earning actions and their current award amounts.'
}

Table xp_events {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  xp_action_id uuid [not null, ref: > xp_actions.id]
  xp_awarded integer [not null, note: 'Snapshot of xp_actions.xp_value at grant time; unaffected by later catalog edits']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, created_at) [name: 'idx_xp_events_user_created']
    xp_action_id [name: 'idx_xp_events_action']
  }

  Note: 'Append-only log of every XP grant actually made to a user.'
}
